  - m_Id: 370455980912640
    m_Localized: Aramak
    m_Metadata:
      m_Items: []
  - m_Id: 370510381035520
    m_Localized: Kimyasallar
    m_Metadata:
      m_Items: []
  - m_Id: 384424028254208
    m_Localized: "Askeri \xFCsse girin"
    m_Metadata:
      m_Items: []
  - m_Id: 384870625161216
    m_Localized: Bilgi bulmak
    m_Metadata:
      m_Items: []
  - m_Id: 384996005490688
    m_Localized: "\u015Eimdi buradan \xE7\u0131kma zaman\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 385080180977664
    m_Localized: "Arabaya D\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 387541377593344
    m_Localized: "Harika, art\u0131k buradan \xE7\u0131kma zaman\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 374218867191808
    m_Localized: "Oneha militanlar\u0131 bir kimyasal depoyu havaya u\xE7urarak b\xFCy\xFCk
      bir ter\xF6r sald\u0131r\u0131s\u0131 d\xFCzenlemeyi planl\u0131yor. Bundan
      sonraki hedefimiz militanlar\u0131 bu depodan \xE7\u0131karmak."
    m_Metadata:
      m_Items: []
  - m_Id: 384260236488704
    m_Localized: "\u0130\u015Fe d\xF6nmene sevindim Booth."
    m_Metadata:
      m_Items: []
  - m_Id: 384343170461696
    m_Localized: "Askeri \xFCss\xFCn\xFC ay\u0131r\u0131n ve di\u011Fer planlar\u0131
      hakk\u0131nda bilgi \xE7ald\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 384791860326400
    m_Localized: "San\u0131r\u0131m \xE7ad\u0131rda arad\u0131\u011F\u0131m\u0131z
      \u015Fey var."
    m_Metadata:
      m_Items: []
  - m_Id: 387774534758400
    m_Localized: "\u0130lgin\xE7. Burada baz\u0131 kimyasallar yaz\u0131yor... Aramaya
      devam edin, daha fazla bilgiye ihtiyac\u0131m\u0131z var."
    m_Metadata:
      m_Items: []
  - m_Id: 387874719903744
    m_Localized: "Harika. Yeterince bilgi sahibi oldu\u011Fumu d\xFC\u015F\xFCn\xFCyorum.
      Art\u0131k buradan \xE7\u0131kman\u0131n zaman\u0131 geldi."
    m_Metadata:
      m_Items: []
  - m_Id: 387967745372160
    m_Localized: "\xC7\u0131kmak"
    m_Metadata:
      m_Items: []
  - m_Id: 400553765351424
    m_Localized: "Oneha'n\u0131n devasa kimyasal tanklar\u0131n\u0131 havaya u\xE7urmay\u0131
      planlad\u0131\u011F\u0131 diz\xFCst\xFC bilgisayarlardan \xF6\u011Frenildi.
      Durdur onlar\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 400592558469120
    m_Localized: "Temizleme alan\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 401153764732928
    m_Localized: "Temizleme alan\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 401403380346880
    m_Localized: "Oneha ter\xF6ristlerini yok edin."
    m_Metadata:
      m_Items: []
  - m_Id: 402058891341824
    m_Localized: "Booth, b\xFCt\xFCn bu tanklar\u0131 g\xF6r\xFCyor musun Booth?
      Onlar\u0131 havaya u\xE7urmak istiyorlar, anl\u0131yor musun?"
    m_Metadata:
      m_Items: []
  - m_Id: 402193566248960
    m_Localized: "Harika, art\u0131k buradan \xE7\u0131kma zaman\u0131. Helikoptere
      binin."
    m_Metadata:
      m_Items: []
  - m_Id: 402469211713536
    m_Localized: "Son durak kald\u0131. Bir saniyemizi bile bo\u015Fa harcamayal\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 370433046458368
    m_Localized: "Onekha grubunun k\xFC\xE7\xFCk bir kamp\u0131 ke\u015Ffedildi.
      \u0130\xE7eri girip planlar\u0131n\u0131 \xF6\u011Frenmelisin."
    m_Metadata:
      m_Items: []
  - m_Id: 781440805875712
    m_Localized: "U\xE7suz bucaks\u0131z \xE7\xF6l\xFCn ortas\u0131nda kumdan b\xFCy\xFCm\xFC\u015F
      gibi k\xFC\xE7\xFCk bir \u015Fehir."
    m_Metadata:
      m_Items: []
  - m_Id: 781387987005440
    m_Localized: Vaha
    m_Metadata:
      m_Items: []
  - m_Id: 782939225174016
    m_Localized: "Ba\u015Flamak i\xE7in herhangi bir tu\u015Fa bas\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 782829481209856
    m_Localized: "Y\xFCkleniyor"
    m_Metadata:
      m_Items: []
  - m_Id: 2092050705395712
    m_Localized: "Ba\u015Flang\u0131\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 3091435786448896
    m_Localized: Basmak
    m_Metadata:
      m_Items: []
  - m_Id: 5794172965859328
    m_Localized: Madinat Jidina
    m_Metadata:
      m_Items: []
  - m_Id: 5794086827438080
    m_Localized: "Bir zamanlar\u0131n b\xFCy\xFCk \u015Fehri, sava\u015Fan g\xFC\xE7lerin
      \xE7at\u0131\u015Fmas\u0131n\u0131n yeri haline geldi. T\xFCm rakipleri yok
      edin."
    m_Metadata:
      m_Items: []
  - m_Id: 10527039700709376
    m_Localized: "U\xE7suz bucaks\u0131z bir \xE7\xF6l\xFCn ortas\u0131nda kumdan
      b\xFCy\xFCyen k\xFC\xE7\xFCk bir \u015Fehir, \xF6l\xFCmc\xFCl bir sava\u015F\u0131n
      alan\u0131 haline geldi."
    m_Metadata:
      m_Items: []
  - m_Id: 10527024316002304
    m_Localized: Vaha
    m_Metadata:
      m_Items: []
  - m_Id: 16338992213897216
    m_Localized: "Haz\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 16338852082200576
    m_Localized: "Mevcut dil: T\xFCrk\xE7e"
    m_Metadata:
      m_Items: []
  - m_Id: 16347118199746560
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 17991848637607936
    m_Localized: "Merakl\u0131 g\xF6zlerden gizlenmi\u015F bir da\u011F kasabas\u0131,
      hayatta kalma oyunu i\xE7in ideal bir yerdir"
    m_Metadata:
      m_Items: []
