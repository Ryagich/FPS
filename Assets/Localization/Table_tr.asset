    m_Metadata:
      m_Items: []
  - m_Id: 25537154472181760
    m_Localized: "Trader fiyatlar\u0131 %20 oran\u0131nda d\xFC\u015F\xFCr\xFCl\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 25537176488083456
    m_Localized: "Trader fiyatlar\u0131 %30 oran\u0131nda d\xFC\u015F\xFCr\xFCl\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 25537199242182656
    m_Localized: "Trader fiyatlar\u0131 %40 oran\u0131nda d\xFC\u015F\xFCr\xFCl\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 25537226559684608
    m_Localized: "Trader fiyatlar\u0131 %50 oran\u0131nda d\xFC\u015F\xFCr\xFCl\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 25537335938744320
    m_Localized: "Bulunan paralar\u0131 ikiye katlama \u015Fans\u0131 %5."
    m_Metadata:
      m_Items: []
  - m_Id: 25537390154317824
    m_Localized: "Bulunan paralar\u0131 ikiye katlama \u015Fans\u0131 %10."
    m_Metadata:
      m_Items: []
  - m_Id: 25537433770885120
    m_Localized: "Bulunan paralar\u0131 ikiye katlama \u015Fans\u0131 %15."
    m_Metadata:
      m_Items: []
  - m_Id: 25537467086241792
    m_Localized: "Bulunan paralar\u0131 ikiye katlama \u015Fans\u0131 %20."
    m_Metadata:
      m_Items: []
  - m_Id: 25537587118833664
    m_Localized: "Bulunan paralar\u0131 ikiye katlama \u015Fans\u0131 %25."
    m_Metadata:
      m_Items: []
  - m_Id: 25537685563342848
    m_Localized: "Bir sat\u0131c\u0131dan yapaca\u011F\u0131n\u0131z ilk al\u0131\u015Fveri\u015Finiz
      \xFCcretsizdir."
    m_Metadata:
      m_Items: []
  - m_Id: 25537721567248384
    m_Localized: "Bir sat\u0131c\u0131dan ilk iki al\u0131\u015Fveri\u015F \xFCcretsizdir."
    m_Metadata:
      m_Items: []
  - m_Id: 25537762885337088
    m_Localized: "Bir sat\u0131c\u0131dan ilk \xFC\xE7 al\u0131\u015Fveri\u015F \xFCcretsizdir."
    m_Metadata:
      m_Items: []
  - m_Id: 25537800936062976
    m_Localized: "Bir sat\u0131c\u0131dan ilk d\xF6rt al\u0131\u015Fveri\u015F \xFCcretsizdir."
    m_Metadata:
      m_Items: []
  - m_Id: 25537860348379136
    m_Localized: "Bir sat\u0131c\u0131dan ilk be\u015F al\u0131\u015Fveri\u015F \xFCcretsizdir."
    m_Metadata:
      m_Items: []
  - m_Id: 25539139623682048
    m_Localized: "Paralar\u0131 ba\u015Flatmak"
    m_Metadata:
      m_Items: []
  - m_Id: 25539197781901312
    m_Localized: "Her tarafta alt\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 25539240471527424
    m_Localized: "Yeni \xFCr\xFCnler"
    m_Metadata:
      m_Items: []
  - m_Id: 25539277511426048
    m_Localized: "\xDCretme"
    m_Metadata:
      m_Items: []
  - m_Id: 25539335518650368
    m_Localized: "Sat\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 25539387007926272
    m_Localized: Saklamak
    m_Metadata:
      m_Items: []
  - m_Id: 25539447351377920
    m_Localized: "Favori m\xFC\u015Fteri"
    m_Metadata:
      m_Items: []
  - m_Id: 28439663406710784
    m_Localized: Yetenekler
    m_Metadata:
      m_Items: []
  - m_Id: 28441243786903552
    m_Localized: Ek Yetenek
    m_Metadata:
      m_Items: []
  - m_Id: 29992631956373504
    m_Localized: Ana Yetenek
    m_Metadata:
      m_Items: []
  - m_Id: 30630950050430976
    m_Localized: "Cephane t\xFCr\xFC:"
    m_Metadata:
      m_Items: []
  - m_Id: 30630996594622464
    m_Localized: "\xC7ekim t\xFCr\xFC:"
    m_Metadata:
      m_Items: []
  - m_Id: 30631126605463552
    m_Localized: "Hareket \xC7arpan\u0131:"
    m_Metadata:
      m_Items: []
  - m_Id: 30631161195888640
    m_Localized: 'Zarar:'
    m_Metadata:
      m_Items: []
  - m_Id: 30631231324651520
    m_Localized: "Ate\u015F h\u0131z\u0131:"
    m_Metadata:
      m_Items: []
  - m_Id: 30631276174344192
    m_Localized: "Da\u011F\u0131l\u0131m:"
    m_Metadata:
      m_Items: []
  - m_Id: 30631319660888064
    m_Localized: 'Dergi kapasitesi:'
    m_Metadata:
      m_Items: []
  - m_Id: 30631331526574080
    m_Localized: Otomatik
    m_Metadata:
      m_Items: []
  - m_Id: 30631348811300864
    m_Localized: Bekar
    m_Metadata:
      m_Items: []
  - m_Id: 30665899948343296
    m_Localized: Yetenekler
    m_Metadata:
      m_Items: []
  - m_Id: 30669024620937216
    m_Localized: "Sat\u0131c\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 30669253587992576
    m_Localized: "Reklam i\xE7in sat\u0131n al\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 30720282899742720
    m_Localized: "\u0130pucu"
    m_Metadata:
      m_Items: []
  - m_Id: 30720330526064640
    m_Localized: "Bir yetenek se\xE7mek i\xE7in karta t\u0131klay\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 30720506846216192
    m_Localized: Yetenekler
    m_Metadata:
      m_Items: []
  - m_Id: 30734557034807296
    m_Localized: Demir el
    m_Metadata:
      m_Items: []
  - m_Id: 31043252675379200
    m_Localized: Demir yumruk
    m_Metadata:
      m_Items: []
  - m_Id: 31045760848199680
    m_Localized: Kritik olmayan hasar %20 artar.
    m_Metadata:
      m_Items: []
  - m_Id: 31045847452188672
    m_Localized: "En iyi say\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31045956340514816
    m_Localized: "Her 4. sald\u0131r\u0131 %80 daha fazla hasar verir."
    m_Metadata:
      m_Items: []
  - m_Id: 31046108409200640
    m_Localized: "\xC7evik Cep"
    m_Metadata:
      m_Items: []
  - m_Id: 31046166433202176
    m_Localized: "Bir nesneyi kald\u0131rd\u0131\u011F\u0131n\u0131zda hareket h\u0131z\u0131
      2 saniye boyunca %20 artar."
    m_Metadata:
      m_Items: []
  - m_Id: 31046244162043904
    m_Localized: "Bo\u011Fa"
    m_Metadata:
      m_Items: []
  - m_Id: 31046308167122944
    m_Localized: "Tam sa\u011Fl\u0131kta, verilen hasar %25 daha y\xFCksektir."
    m_Metadata:
      m_Items: []
  - m_Id: 31046614250651648
    m_Localized: "\xD6nleyici sald\u0131r\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31046777295831040
    m_Localized: "\u015Earj\xF6rdeki ilk mermi %100 daha fazla hasar verir."
    m_Metadata:
      m_Items: []
  - m_Id: 31046936218009600
    m_Localized: "Kararl\u0131l\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 31047283854508032
    m_Localized: "Kalkan olmad\u0131\u011F\u0131nda hareket h\u0131z\u0131 %50 artar."
    m_Metadata:
      m_Items: []
  - m_Id: 31047768049156096
    m_Localized: Kaliteli mermiler
    m_Metadata:
      m_Items: []
  - m_Id: 31049837237731328
    m_Localized: "Kartu\u015Flar\u0131 al\u0131rken 2 birim z\u0131rh da geri y\xFCklenir."
    m_Metadata:
      m_Items: []
  - m_Id: 31049944809046016
    m_Localized: "Alt\u0131n a\u015Fk\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31050041177374720
    m_Localized: "Madeni para ve kristal toplarken 1 birim sa\u011Fl\u0131k da yenilenir."
    m_Metadata:
      m_Items: []
  - m_Id: 31050116293165056
    m_Localized: "\xC7ift Patlama"
    m_Metadata:
      m_Items: []
  - m_Id: 31050241094680576
    m_Localized: "Ek yetene\u011Fin g\xFCc\xFC iki kat\u0131na \xE7\u0131kar."
    m_Metadata:
      m_Items: []
  - m_Id: 31050410372595712
    m_Localized: "\u015Eeytan\u0131n Anla\u015Fmas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31050468623089664
    m_Localized: "Sa\u011Fl\u0131k yar\u0131 yar\u0131ya azald\u0131. T\xFCm kaynaklardan
      iki kat daha fazla para ve kristal al\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 31050782344445952
    m_Localized: Hayalet Mermi
    m_Metadata:
      m_Items: []
  - m_Id: 31050850044706816
    m_Localized: "Yeniden doldururken kartu\u015Fun bo\u015Fa gitmeme \u015Fans\u0131
      %30'dur."
    m_Metadata:
      m_Items: []
  - m_Id: 31050918592217088
    m_Localized: Sertlik
    m_Metadata:
      m_Items: []
  - m_Id: 31051762750423040
    m_Localized: Sabit durumdayken hasar %50 artar.
    m_Metadata:
      m_Items: []
  - m_Id: 31052097741094912
    m_Localized: "Anormal h\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 31052166770950144
    m_Localized: "Her %10 kalkan i\xE7in +%2 hareket h\u0131z\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 31052221187850240
    m_Localized: "Mermi bankas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31052269296517120
    m_Localized: "Toplanan t\xFCm cephane, mevcut silah\u0131n kulland\u0131\u011F\u0131
      cephaneye d\xF6n\xFC\u015Ft\xFCr\xFCl\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 31052340490633216
    m_Localized: "D\xFCzenli"
    m_Metadata:
      m_Items: []
  - m_Id: 31052391908605952
    m_Localized: "T\xFCm kaynaklardan al\u0131nan iyile\u015Ftirme iki kat\u0131na
      \xE7\u0131kar."
    m_Metadata:
      m_Items: []
  - m_Id: 31052465099210752
    m_Localized: Kumar
    m_Metadata:
      m_Items: []
  - m_Id: 31052550314885120
    m_Localized: "+%50 kritik sald\u0131r\u0131 hasar\u0131, ancak normal sald\u0131r\u0131lar
      %20 daha az hasar verir."
    m_Metadata:
      m_Items: []
  - m_Id: 31053115098890240
    m_Localized: "K\u0131sa bir mola"
    m_Metadata:
      m_Items: []
  - m_Id: 31053187169615872
    m_Localized: "Yeniden \u015Farj edildikten sonra 2 saniye boyunca hasara kar\u015F\u0131
      ba\u011F\u0131\u015F\u0131kl\u0131k kazan\u0131rs\u0131n\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 31053245332029440
    m_Localized: "\xE7\u0131lg\u0131na d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 31053303653826560
    m_Localized: "Eksik sa\u011Fl\u0131\u011F\u0131n her %5'i i\xE7in +%1 kritik
      \u015Fans."
    m_Metadata:
      m_Items: []
  - m_Id: 31053392753426432
    m_Localized: Yepyeni
    m_Metadata:
      m_Items: []
  - m_Id: 31053466686423040
    m_Localized: "Z\u0131rh doluysa verilen hasar +%75, aksi halde -%25 hasar."
    m_Metadata:
      m_Items: []
  - m_Id: 31053528334303232
    m_Localized: Kupa
    m_Metadata:
      m_Items: []
  - m_Id: 31053587549487104
    m_Localized: "Yenilen bir d\xFC\u015Fman\u0131n cephanesini devirme \u015Fans\u0131
      %25'tir."
    m_Metadata:
      m_Items: []
  - m_Id: 31053654327001088
    m_Localized: "Uzak g\xF6r\xFC\u015Fl\xFCl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 31053710518091776
    m_Localized: "10 metre veya daha fazla mesafedeki rakipler %50 daha fazla hasar
      al\u0131r, daha yak\u0131nda bulunan rakipler ise %15 daha az hasar al\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 31056074318774272
    m_Localized: "Sat\u0131c\u0131dan bir sonraki al\u0131\u015Fveri\u015Finiz \xFCcretsiz
      olacakt\u0131r. Yetenek kullan\u0131ld\u0131ktan sonra kaybolur."
    m_Metadata:
      m_Items: []
  - m_Id: 31056131365502976
    m_Localized: "Alt\u0131n kart"
    m_Metadata:
      m_Items: []
  - m_Id: 31056224273530880
    m_Localized: "Z\u0131rh plakas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31056289226522624
    m_Localized: "Z\u0131rh plakalar\u0131n\u0131 kullanmaya ba\u015Flay\u0131n.
      Z\u0131rh plakas\u0131 daha fazla hasar\u0131 engeller ve ard\u0131ndan k\u0131r\u0131l\u0131r.
      Her 10 saniyede bir 1 z\u0131rh plakas\u0131n\u0131 yenileyin. Maksimum 3 z\u0131rh
      plakas\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 31056511377833984
    m_Localized: "Kaliteli ayakkab\u0131lar"
    m_Metadata:
      m_Items: []
  - m_Id: 31056553195044864
    m_Localized: "Hareket h\u0131z\u0131 %15 artar."
    m_Metadata:
      m_Items: []
  - m_Id: 31056647457832960
    m_Localized: "S\xFCrpriz"
    m_Metadata:
      m_Items: []
  - m_Id: 31056710494027776
    m_Localized: "Bir d\xFC\u015Fman\u0131 \xF6ld\xFCr\xFCrken, ek para veya ek bir
      beceri i\xE7in \xFCcret al\u0131nd\u0131\u011F\u0131nda %10 nakavt \u015Fans\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 31056775094697984
    m_Localized: Gizli Hazineler
    m_Metadata:
      m_Items: []
  - m_Id: 31056825413763072
    m_Localized: "K\u0131r\u0131labilir nesnelerde madeni para veya kristal bulma
      \u015Fans\u0131 artar. Di\u011Fer her \u015Feyi bulma \u015Fans\u0131 daha
      d\xFC\u015F\xFCkt\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 31056904224735232
    m_Localized: "\u0130yi \u015Feyler bekle"
    m_Metadata:
      m_Items: []
  - m_Id: 31056953046433792
    m_Localized: "Her 3 saniyede bir yap\u0131lan ilk at\u0131\u015F kritik olacakt\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 31057030422953984
    m_Localized: Vampir
    m_Metadata:
      m_Items: []
  - m_Id: 31057081501188096
    m_Localized: "Sald\u0131r\u0131lar 1 birim sa\u011Fl\u0131\u011F\u0131 yeniler,
      sa\u011Fl\u0131k doluysa z\u0131rh yenilenir. Sald\u0131r\u0131lar %50 daha
      az hasar verir."
    m_Metadata:
      m_Items: []
  - m_Id: 31057141697839104
    m_Localized: "Boks\xF6r"
    m_Metadata:
      m_Items: []
  - m_Id: 31057205505785856
    m_Localized: "5 metreden daha yak\u0131n bir mesafede duran bir d\xFC\u015Fmana
      kritik hasar verme \u015Fans\u0131 iki kat\u0131na \xE7\u0131kar."
    m_Metadata:
      m_Items: []
  - m_Id: 31057732822073344
    m_Localized: "Mermi \u0131\u015F\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31057780205125632
    m_Localized: "Yeniden y\xFCkleme iki kat daha fazla cephane t\xFCketir (esas
      olarak kullan\u0131lmayan m\xFChimmat t\xFCrlerinden dolay\u0131). Kritik vuru\u015F
      \u015Fans\u0131 %25 artar."
    m_Metadata:
      m_Items: []
  - m_Id: 31057878158901248
    m_Localized: "Taktiksel yeniden y\xFCkleme"
    m_Metadata:
      m_Items: []
  - m_Id: 31057930998743040
    m_Localized: "Yeniden y\xFCkleme s\u0131ras\u0131nda hareket h\u0131z\u0131 %25
      artar ve al\u0131nan hasar %10 azal\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 31058101526560768
    m_Localized: "Ya\u015Fam a\u015Fk\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31058142538465280
    m_Localized: "Hasar al\u0131nd\u0131ktan sonra 3 sa\u011Fl\u0131k birimi 5 saniye
      i\xE7inde yenilenir."
    m_Metadata:
      m_Items: []
  - m_Id: 31058353398710272
    m_Localized: "K\xF6t\xFC el"
    m_Metadata:
      m_Items: []
  - m_Id: 31058410890035200
    m_Localized: "Ek beceri y\xFCkleriniz varsa %75 daha fazla hasar verin, yoksa
      %25 daha az hasar verin."
    m_Metadata:
      m_Items: []
  - m_Id: 31058460814835712
    m_Localized: Kin
    m_Metadata:
      m_Items: []
  - m_Id: 31058510748024832
    m_Localized: "Hasar ald\u0131\u011F\u0131n\u0131zda kendi hasar\u0131n\u0131z
      5 saniye boyunca %15 artar."
    m_Metadata:
      m_Items: []
  - m_Id: 31058639177613312
    m_Localized: "\u0130kinci \u015Fans"
    m_Metadata:
      m_Items: []
  - m_Id: 31058694127190016
    m_Localized: "\xD6l\xFCmc\xFCl hasar ald\u0131\u011F\u0131n\u0131zda maksimum
      sa\u011Fl\u0131\u011F\u0131n\u0131z\u0131n %10'unu yenileyin. Beceri tetiklendikten
      sonra kaybolur."
    m_Metadata:
      m_Items: []
  - m_Id: 31058773680553984
    m_Localized: "\xD6l\xFC ruh"
    m_Metadata:
      m_Items: []
  - m_Id: 31058827006935040
    m_Localized: "\xD6l\xFCmc\xFCl hasar ald\u0131ktan sonra 5 saniye boyunca yenilmez
      olun, bu s\xFCre zarf\u0131nda sa\u011Fl\u0131\u011F\u0131n\u0131z\u0131 yenilemezseniz
      \xF6l\xFCrs\xFCn\xFCz. Beceri tetiklendikten sonra kaybolur."
    m_Metadata:
      m_Items: []
  - m_Id: 31058899727777792
    m_Localized: Paranormal
    m_Metadata:
      m_Items: []
  - m_Id: 31058952466956288
    m_Localized: "Maksimum sa\u011Fl\u0131k 1 birime d\xFC\u015Fer. Z\u0131rh miktar\u0131
      \xFC\xE7 kat\u0131na \xE7\u0131kar."
    m_Metadata:
      m_Items: []
  - m_Id: 31059004375662592
    m_Localized: "Canl\u0131 et"
    m_Metadata:
      m_Items: []
  - m_Id: 31059096268668928
    m_Localized: "Her saniye maksimum sa\u011Fl\u0131\u011F\u0131n\u0131z\u0131n
      %4'\xFC eksik z\u0131rha d\xF6n\xFC\u015Ft\xFCr\xFCl\xFCr. Yetene\u011Fin kullan\u0131lmas\u0131
      sonucunda sa\u011Fl\u0131k %20'nin alt\u0131na d\xFC\u015Femez."
    m_Metadata:
      m_Items: []
  - m_Id: 31059159950786560
    m_Localized: "Kurtar\u0131c\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31059214011170816
    m_Localized: "\xD6l\xFCmc\xFCl hasar ald\u0131ktan sonra sa\u011Fl\u0131\u011F\u0131n\u0131z\u0131n
      %10'unu yenileyin, e\u011Fer yetenek tetiklendikten sonraki 5 saniye i\xE7inde
      tek bir d\xFC\u015Fman\u0131 \xF6ld\xFCrmezseniz \xF6l\xFCrs\xFCn\xFCz. Beceri
      tetiklendikten sonra kaybolur."
    m_Metadata:
      m_Items: []
  - m_Id: 31059289005326336
    m_Localized: "Kanl\u0131 m\xFChimmat"
    m_Metadata:
      m_Items: []
  - m_Id: 31059340918226944
    m_Localized: "\u015Earj\xF6r bo\u015Fald\u0131\u011F\u0131nda ate\u015F etmeye
      devam edersiniz, at\u0131\u015F ba\u015F\u0131na %2 daha fazla hasar verirsiniz
      ve at\u0131\u015F ba\u015F\u0131na maksimum sa\u011Fl\u0131\u011F\u0131n\u0131z\u0131n
      %1'ini kaybedersiniz. Bir becerinin kullan\u0131lmas\u0131 sonucunda \xF6lmek
      m\xFCmk\xFCnd\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 31059392487194624
    m_Localized: Stoklamak
    m_Metadata:
      m_Items: []
  - m_Id: 31059441489248256
    m_Localized: "Maksimum z\u0131rh\u0131n\u0131z\u0131n %50'sini ve maksimum sa\u011Fl\u0131\u011F\u0131n\u0131z\u0131n
      %50'sini kaybedersiniz. Fazladan 2 can kazan\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 31059523341090816
    m_Localized: Anemi
    m_Metadata:
      m_Items: []
  - m_Id: 31059578219364352
    m_Localized: "Maksimum sa\u011Fl\u0131k iki kat\u0131na \xE7\u0131kar. T\xFCm
      kaynaklardan %10 daha fazla hasar al\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 31059737359646720
    m_Localized: Disiplin
    m_Metadata:
      m_Items: []
  - m_Id: 31059792305029120
    m_Localized: "Kritik at\u0131\u015F \u015Fans\u0131 her saniye %5 artar. Kritik
      bir at\u0131\u015F yap\u0131ld\u0131ktan sonra s\u0131f\u0131rlan\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 31059851427938304
    m_Localized: "Dev Avc\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31060503931617280
    m_Localized: "Bir d\xFC\u015Fman hasar ald\u0131\u011F\u0131nda maksimum sa\u011Fl\u0131\u011F\u0131n\u0131n
      %5'inin bonus hasara d\xF6n\xFC\u015Ft\xFCr\xFClme \u015Fans\u0131 %5'tir."
    m_Metadata:
      m_Items: []
  - m_Id: 31061095064240128
    m_Localized: "Uzayl\u0131 enerjisi"
    m_Metadata:
      m_Items: []
  - m_Id: 31061156036837376
    m_Localized: "Bir d\xFC\u015Fman\u0131 \xF6ld\xFCr\xFCrken 5 z\u0131rh\u0131
      yenileme \u015Fans\u0131 %50'dir."
    m_Metadata:
      m_Items: []
  - m_Id: 31061486338277376
    m_Localized: "Y\u0131ld\u0131r\u0131m"
    m_Metadata:
      m_Items: []
  - m_Id: 31061579061755904
    m_Localized: "Mevcut h\u0131z\u0131n\u0131z ne kadar y\xFCksek olursa, ald\u0131\u011F\u0131n\u0131z
      hasara kar\u015F\u0131 direnciniz de o kadar y\xFCksek olur. Maksimum %30."
    m_Metadata:
      m_Items: []
  - m_Id: 31061787724185600
    m_Localized: "Savurganl\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 31061871878701056
    m_Localized: "Harcanan her 100 cephane i\xE7in +%10 hasar direnci."
    m_Metadata:
      m_Items: []
  - m_Id: 31061950547066880
    m_Localized: Madenci
    m_Metadata:
      m_Items: []
  - m_Id: 31062009099550720
    m_Localized: "7 metre i\xE7indeki d\xFC\u015Fmanlar\u0131 \xF6ld\xFCrmenin \xF6d\xFCl\xFC
      iki kat daha y\xFCksektir."
    m_Metadata:
      m_Items: []
  - m_Id: 31062079006015488
    m_Localized: "K\u0131demli"
    m_Metadata:
      m_Items: []
  - m_Id: 31062158857175040
    m_Localized: "7 metreye kadar uzakta \xF6ld\xFCr\xFClen her d\xFC\u015Fman i\xE7in
      +1 ila maksimum sa\u011Fl\u0131k."
    m_Metadata:
      m_Items: []
  - m_Id: 31062225408196608
    m_Localized: "Yumurta kabu\u011Fu"
    m_Metadata:
      m_Items: []
  - m_Id: 31062291074220032
    m_Localized: "Z\u0131rh giyerken ilave %15 hasar direnci kazan\u0131rs\u0131n\u0131z.
      Z\u0131rhl\u0131 olmad\u0131\u011F\u0131n\u0131zda hasara kar\u015F\u0131 %15
      savunmas\u0131z olun."
    m_Metadata:
      m_Items: []
  - m_Id: 31062367293112320
    m_Localized: "H\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 31062452806582272
    m_Localized: "Hareket h\u0131z\u0131 %50 daha y\xFCksektir, ana beceri %150 daha
      uzun s\xFCre yenilenir."
    m_Metadata:
      m_Items: []
  - m_Id: 31062536822685696
    m_Localized: "M\xFCmk\xFCn olan\u0131n s\u0131n\u0131r\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31062713918783488
    m_Localized: "Ek beceri, mermi olmad\u0131\u011F\u0131nda bile kullan\u0131labilir;
      bu t\xFCr her kullan\u0131m i\xE7in 25 puanl\u0131k hasar al\u0131rs\u0131n\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 31062784479559680
    m_Localized: Uyuyan mermi
    m_Metadata:
      m_Items: []
  - m_Id: 31062850485321728
    m_Localized: "\u015Earj\xF6rde ne kadar az cephane kal\u0131rsa silah\u0131n
      hasar\u0131 o kadar y\xFCksek olur (maksimum +%75)."
    m_Metadata:
      m_Items: []
  - m_Id: 31062918873448448
    m_Localized: "Madalyonun iki y\xFCz\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 31062984656912384
    m_Localized: "Her 12 saniyede bir Yin ve Yang durumlar\u0131 aras\u0131nda ge\xE7i\u015F
      yap\u0131n. Yin durumu, hasar direncine +%20 verir ve Yang durumu, verilen
      hasara +%50 verir."
    m_Metadata:
      m_Items: []
  - m_Id: 31063098184138752
    m_Localized: "\u0130ki ucu keskin k\u0131l\u0131\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 31063184452583424
    m_Localized: "Yenilen her d\xFC\u015Fman i\xE7in +%1 hasar ve -%0,5 hasar direnci
      kazan\u0131rs\u0131n\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 31063278077837312
    m_Localized: "\xD6fke"
    m_Metadata:
      m_Items: []
  - m_Id: 31063336345108480
    m_Localized: "Hasar al\u0131rken, 5 saniye boyunca +%20 kritik hasar verme \u015Fans\u0131na
      sahip olacaks\u0131n\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 31063401612673024
    m_Localized: "Alt\u0131n z\u0131rh"
    m_Metadata:
      m_Items: []
  - m_Id: 31063503441985536
    m_Localized: "Ek bir beceri kullan\u0131rken z\u0131rh\u0131n %5'ini maksimumdan
      yenileyin."
    m_Metadata:
      m_Items: []
  - m_Id: 31063593569189888
    m_Localized: "L\xFCtuf"
    m_Metadata:
      m_Items: []
  - m_Id: 31063675618164736
    m_Localized: "Hasar direncini %100 azalt\u0131n, ancak al\u0131nan hasar maksimum
      sa\u011Fl\u0131\u011F\u0131n %10'unu a\u015Famaz."
    m_Metadata:
      m_Items: []
  - m_Id: 31063749253365760
    m_Localized: "Ya hep ya hi\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 31063838109696000
    m_Localized: "%100 hasar kazan\u0131n. Maksimum sa\u011Fl\u0131\u011F\u0131n\u0131z\u0131n
      %75'ini kaybedersiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 31063908662083584
    m_Localized: Delici mermi
    m_Metadata:
      m_Items: []
  - m_Id: 31064012856983552
    m_Localized: "Kritik sald\u0131r\u0131lar d\xFC\u015Fman z\u0131rh\u0131n\u0131
      deler."
    m_Metadata:
      m_Items: []
  - m_Id: 31064089025544192
    m_Localized: Atlantik
    m_Metadata:
      m_Items: []
  - m_Id: 31064140158304256
    m_Localized: "Stoktaki her 100 jeton i\xE7in +%5 hasar."
    m_Metadata:
      m_Items: []
  - m_Id: 31064210505170944
    m_Localized: "Yedek z\u0131rh"
    m_Metadata:
      m_Items: []
  - m_Id: 31064285067313152
    m_Localized: "Z\u0131rh k\u0131r\u0131ld\u0131\u011F\u0131nda z\u0131rh\u0131n
      %10'unu an\u0131nda yeniler. Yeniden y\xFCkleme s\xFCresi 45 saniye."
    m_Metadata:
      m_Items: []
  - m_Id: 31064475794898944
    m_Localized: "A\u011F\u0131r z\u0131rh"
    m_Metadata:
      m_Items: []
  - m_Id: 31064603607924736
    m_Localized: "+50 Maksimum Kalkan ve +%10 Hasar Direnci kazan\u0131n. %20 hareket
      h\u0131z\u0131 kaybedersiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 31064681911386112
    m_Localized: "Makul \u015Eans"
    m_Metadata:
      m_Items: []
  - m_Id: 31064749796196352
    m_Localized: "+%50 kritik hasar verme \u015Fans\u0131, ancak maksimum \u015Fans
      %75'i ge\xE7emez."
    m_Metadata:
      m_Items: []
  - m_Id: 31065196049170432
    m_Localized: "Ya\u015Fayan z\u0131rh"
    m_Metadata:
      m_Items: []
  - m_Id: 36450387831926784
    m_Localized: "M\xFCzik Sesi"
    m_Metadata:
      m_Items: []
  - m_Id: 36495000718389248
    m_Localized: 'Mevcut seviye:'
    m_Metadata:
      m_Items: []
  - m_Id: 45881654637232128
    m_Localized: "D\xFC\u015Fmanlar\u0131 bir d\xFC\u015Fman \xF6lene kadar sald\u0131rmaya
      zorlar"
    m_Metadata:
      m_Items: []
  - m_Id: 45881692562128896
    m_Localized: "Yan\u0131lsama"
    m_Metadata:
      m_Items: []
  - m_Id: 121833317132595200
    m_Localized: "Sa\u011Fl\u0131k restorasyonu"
    m_Metadata:
      m_Items: []
  - m_Id: 121833452545699840
    m_Localized: "T\xFCm sa\u011Fl\u0131\u011F\u0131 tamamen geri y\xFCkleyin"
    m_Metadata:
      m_Items: []
  - m_Id: 121833563111747584
    m_Localized: "Z\u0131rh restorasyonu"
    m_Metadata:
      m_Items: []
  - m_Id: 121833605985923072
    m_Localized: "T\xFCm z\u0131rh\u0131 tamamen yenile"
    m_Metadata:
      m_Items: []
  - m_Id: 121834196472623104
    m_Localized: "Ek bir yetene\u011Fi geri y\xFCkleme"
    m_Metadata:
      m_Items: []
  - m_Id: 121834435917049856
    m_Localized: "T\xFCm ek yetenek \xFCcretlerini kurtar\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 121835587463213056
    m_Localized: "T\xFCm m\xFChimmat\u0131 tamamen yenileyin"
    m_Metadata:
      m_Items: []
  - m_Id: 121835881005772800
    m_Localized: "M\xFChimmat kurtarma"
    m_Metadata:
      m_Items: []
  - m_Id: 121836343016747008
    m_Localized: "Maksimum sa\u011Fl\u0131\u011F\u0131n\u0131z\u0131 kal\u0131c\u0131
      olarak art\u0131r\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 121836476638883840
    m_Localized: "Maksimum Sa\u011Fl\u0131k Art\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 121844121009582080
    m_Localized: "Maksimum z\u0131rh\u0131n\u0131z\u0131 art\u0131r\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 121844188810506240
    m_Localized: "Maksimum z\u0131rh\u0131n\u0131z\u0131 kal\u0131c\u0131 olarak
      art\u0131r\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 121844353659236352
    m_Localized: "Ek bir yetene\u011Fin maksimum miktar\u0131n\u0131 kal\u0131c\u0131
      olarak art\u0131r\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 121844388409044992
    m_Localized: "Maksimum ekstra say\u0131s\u0131n\u0131 art\u0131r\u0131n. yetenekler"
    m_Metadata:
      m_Items: []
  - m_Id: 121844497322536960
    m_Localized: "Maksimum cephane miktar\u0131n\u0131z\u0131 art\u0131r\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 121844950122819584
    m_Localized: "Maksimum cephane ve el bombalar\u0131n\u0131z\u0131 kal\u0131c\u0131
      olarak art\u0131r\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 121845022231293952
    m_Localized: "Hasar Art\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 121845104129273856
    m_Localized: "Verdi\u011Finiz t\xFCm hasar\u0131 art\u0131r\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 121845156855869440
    m_Localized: "\u0130kinci hayat"
    m_Metadata:
      m_Items: []
  - m_Id: 121845452571078656
    m_Localized: "\u0130kinci bir hayat sat\u0131n al\u0131n.\r\nKullan\u0131mdan
      sonra hayat kaybolur."
    m_Metadata:
      m_Items: []
  - m_Id: 122474811233333248
    m_Localized: Yama
    m_Metadata:
      m_Items: []
  - m_Id: 122474845043617792
    m_Localized: "30 z\u0131rh birimini yeniler."
    m_Metadata:
      m_Items: []
  - m_Id: 122737281864757248
    m_Localized: Kafaya
    m_Metadata:
      m_Items: []
  - m_Id: 122806134456119296
    m_Localized: "Sand\u0131\u011F\u0131 a\xE7 ve yetene\u011Fi al"
    m_Metadata:
      m_Items: []
  - m_Id: 122807583701397504
    m_Localized: Arabaya binin.
    m_Metadata:
      m_Items: []
  - m_Id: 123501049787904000
    m_Localized: 'Maliyet:'
    m_Metadata:
      m_Items: []
  - m_Id: 125009717381492736
    m_Localized: "Sand\u0131\u011F\u0131 a\xE7 ve yetene\u011Fi al"
    m_Metadata:
      m_Items: []
  - m_Id: 125016869508673536
    m_Localized: Arabaya binin.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
