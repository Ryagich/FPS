  - m_Id: 24517222674432000
    m_Localized: "Her saniye 1 sa\u011Fl\u0131\u011F\u0131 yenileyin."
    m_Metadata:
      m_Items: []
  - m_Id: 24517231117565952
    m_Localized: "Her saniye 2 sa\u011Fl\u0131k birimini yenileyin."
    m_Metadata:
      m_Items: []
  - m_Id: 24517564795420672
    m_Localized: "T\xFCm kaynaklardan %5 daha az hasar al\u0131n."
    m_Metadata:
      m_Items: []
