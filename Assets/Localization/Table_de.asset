    m_Metadata:
      m_Items: []
  - m_Id: 24517231117565952
    m_Localized: Stellt jede Sekunde 2 Gesundheitseinheiten wieder her.
    m_Metadata:
      m_Items: []
  - m_Id: 24517564795420672
    m_Localized: Erleide 5 % weniger Schaden aus allen Quellen.
    m_Metadata:
      m_Items: []
  - m_Id: 24517568691929088
    m_Localized: Erleide 10 % weniger Schaden aus allen Quellen.
    m_Metadata:
      m_Items: []
  - m_Id: 24517582210170880
    m_Localized: Erleide 15 % weniger Schaden aus allen Quellen.
    m_Metadata:
      m_Items: []
  - m_Id: 24517591131455488
    m_Localized: Erleide 20 % weniger Schaden aus allen Quellen.
    m_Metadata:
      m_Items: []
  - m_Id: 24517605178179584
    m_Localized: Erleide 25 % weniger Schaden aus allen Quellen.
