    m_Localized: "\u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0431\u043E\u0435\u0446,
      \u043F\u043E\u0431\u044B\u0432\u0430\u0432\u0448\u0438\u0439 \u0432\u043E \u043C\u043D\u043E\u0433\u0438\u0445
      \u0433\u043E\u0440\u044F\u0447\u0438\u0445 \u0442\u043E\u0447\u043A\u0430\u0445
      \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u043C\u0438\u0440\u0443. \u041C\u043E\u0436\u043D\u043E
      \u0434\u043E\u043B\u0433\u043E \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u044F\u0442\u044C
      \u0435\u0433\u043E \u043D\u0430\u0433\u0440\u0430\u0434\u044B, \u043D\u043E
      \u043E\u0434\u043D\u043E \u043C\u043E\u0436\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u0442\u043E\u0447\u043D\u043E - \u0420\u044D\u043C\u0431\u043E \u043B\u0443\u0447\u0448\u0438\u0439
      \u0438\u0437 \u043B\u0443\u0447\u0448\u0438\u0445, \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F
      \u044D\u043B\u0438\u0442\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0445
      \u0441\u0438\u043B. \u0420\u044D\u043C\u0431\u043E \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438
      \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0441 \u043E\u0440\u0443\u0436\u0438\u0435\u043C
      \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0431\u043E\u044F \u0442\u0430\u043A\u0438\u043C\u0438
      \r\n+20% \u043A \u0443\u0440\u043E\u043D\u0443 \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
      \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B
      \u041F\u041F \u0438 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u043E\u0432.\r\n-10%
      \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438 \u0432\u0441\u0435\u0433\u043E
      \u043E\u0440\u0443\u0436\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 24565575860846592
    m_Localized: "\u0411\u0443\u0442 \u2014 \u043E\u043F\u044B\u0442\u043D\u044B\u0439
      \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0438\u043A, \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0438\u0439\u0441\u044F
      \u043D\u0430 \u0448\u043F\u0438\u043E\u043D\u0441\u043A\u0438\u0445 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F\u0445.
      \u041E\u043D \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E
      \u0441\u043A\u0440\u044B\u0442\u0435\u043D, \u0442\u0440\u0443\u0434\u043D\u043E
      \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0432 \u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F\u0445 \u043E\u043D \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B
      \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0438 \u0434\u0430\u0436\u0435
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0435\u043C\u0443 \u043B\u0435\u0442
      \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043B\u0438 \u0435\u0433\u043E \u0437\u043E\u0432\u0443\u0442 \u0411\u0443\u0442.
      \u041C\u044B \u043C\u043E\u0436\u0435\u043C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E
      \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u043E\u043D
      \u043B\u0438\u043A\u0432\u0438\u0434\u0438\u0440\u043E\u0432\u0430\u043B \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
      \u0442\u0435\u0440\u0440\u043E\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043E\u043A \u0438 \u043B\u0438\u043A\u0432\u0438\u0434\u0438\u0440\u0443\u0435\u0442
      \u043D\u0435 \u043E\u0434\u043D\u0443.\r\n\u0423\u0440\u043E\u043D \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u0432
      +50%.\r\n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
      \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u0432 \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043E\u0432
      +10%."
    m_Metadata:
      m_Items: []
  - m_Id: 24565592822611968
    m_Localized: "\u0411\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 24565614632992768
    m_Localized: "\u0420\u044D\u043C\u0431\u043E"
    m_Metadata:
