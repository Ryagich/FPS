  - m_Id: 24565635059253248
    m_Localized: "\u0422\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 24565712016343040
    m_Localized: "\u0422\u0435\u043D\u044C \u2013 \u0432\u0435\u0447\u043D\u043E
      \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E\u0449\u0438\u0439
      \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u043E \u043B\u044E\u0431\u043E\u0439
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438. \u0417\u0430 \u0435\u0433\u043E
      \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C
      \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043C\u0430\u0441\u0442\u0435\u0440
      \u0443\u0431\u0438\u0439\u0441\u0442\u0432, \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0439
      \u0448\u0430\u043D\u0441\u043E\u0432 \u0441\u0432\u043E\u0438\u043C \u0436\u0435\u0440\u0442\u0432\u0430\u043C.
      \u041D\u0435\u0442 \u0432 \u043C\u0438\u0440\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u043C\u043E\u0436\u0435\u0442
      \u0443\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u043E\u0442 \u043F\u0443\u043B\u0438
      \u0422\u0435\u043D\u0438.\r\n+20% \u0443\u0440\u043E\u043D\u0430 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0445
      \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A.\r\n+25% \u043A \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
      \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A.\r\n+25%
      \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438 \u0438 -20% \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
      \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0434\u043B\u044F \u0432\u0441\u0435\u0433\u043E
      \u043E\u0440\u0443\u0436\u0438\u044F.\r\n+5% \u0448\u0430\u043D\u0441 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0430\u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 24565760913539072
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043A\u0440\u043E\u0432\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 24565942598205440
    m_Localized: "\u041F\u0440\u0438 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438
      \u0420\u044D\u043C\u0431\u043E \u043D\u0430 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0435\u0442
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0431\u043E\u043B\u044C
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u0443\u0440\u043E\u043D.\r\n\u0415\u0441\u043B\u0438
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0439
      \u0443\u0440\u043E\u043D \u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u0430
      \u043A \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044E,
      \u043E\u043D\u0430 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 24565980846063616
    m_Localized: "\u0417\u0430\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 24566015482626048
    m_Localized: "\u041F\u0440\u0438 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438
      \u0434\u0430\u0435\u0442 10% \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
      \u0438 12% \u0431\u0440\u043E\u043D\u0438.\r\n\u0412\u043E\u0441\u043F\u043E\u043B\u043D\u044F\u0435\u0442
      20% \u0432\u0441\u0435\u0445 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u043E\u0442 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 24567533216694272
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u043D\u0430
      \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
      \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442 \u0432\u0440\u0435\u043C\u044F.\r\n\u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438
      \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0442\u0441\u044F \u0441\u0438\u043B\u044C\u043D\u0435\u0435,
      \u0447\u0435\u043C \u0411\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 24567566334918656
    m_Localized: "\u041E\u0441\u0442\u0440\u0430\u044F \u0440\u0435\u0430\u043A\u0446\u0438\u044F"
