    <Sprite>k__BackingField: {fileID: 21300000, guid: 654f1188d88eeeb4ba5934f5755e41a0,
      type: 3}
    <BackgroundColor>k__BackingField: {r: 0, g: 0, b: 0, a: 0}
    <Opened>k__BackingField: 0
  - <Name>k__BackingField: Determination
    <Description>k__BackingField: Movement speed increases by 50% when there is no
      shield.
    <Sprite>k__BackingField: {fileID: 21300000, guid: 29d26b5186befda448b70fcbe49a1984,
      type: 3}
    <BackgroundColor>k__BackingField: {r: 0, g: 0, b: 0, a: 0}
    <Opened>k__BackingField: 0
  - <Name>k__BackingField: Quality bullets
    <Description>k__BackingField: When picking up cartridges, 2 units of armor are
