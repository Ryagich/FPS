  m_text: "\u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0431\u043E\u0435\u0446, \u043F\u043E\u0431\u044B\u0432\u0430\u0432\u0448\u0438\u0439
    \u0432\u043E \u043C\u043D\u043E\u0433\u0438\u0445 \u0433\u043E\u0440\u044F\u0447\u0438\u0445
    \u0442\u043E\u0447\u043A\u0430\u0445 \u043F\u043E \u0432\u0441\u0435\u043C\u0443
    \u043C\u0438\u0440\u0443. \u041C\u043E\u0436\u043D\u043E \u0434\u043E\u043B\u0433\u043E
    \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u044F\u0442\u044C \u0435\u0433\u043E
    \u043D\u0430\u0433\u0440\u0430\u0434\u044B, \u043D\u043E \u043E\u0434\u043D\u043E
    \u043C\u043E\u0436\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0442\u043E\u0447\u043D\u043E
    - \u0420\u044D\u043C\u0431\u043E \u043B\u0443\u0447\u0448\u0438\u0439 \u0438\u0437
    \u043B\u0443\u0447\u0448\u0438\u0445, \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F
    \u044D\u043B\u0438\u0442\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0445
    \u0441\u0438\u043B. \u0420\u044D\u043C\u0431\u043E \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438
    \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0441 \u043E\u0440\u0443\u0436\u0438\u0435\u043C
    \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0431\u043E\u044F \u0442\u0430\u043A\u0438\u043C\u0438
    (+20% \u043A \u0443\u0440\u043E\u043D\u0443 \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u041F\u041F \u0438 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u043E\u0432)."
