MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 12224421}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1569426cc2088a349945f0352b1266aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _idlePlaces:
  - {fileID: 1883355953}
  - {fileID: 555452592}
  - {fileID: 1690090498}
  _readyCharacters:
  - {fileID: 549884647}
  - {fileID: 1134140324}
  - {fileID: 387011021}
  _leftButton: {fileID: 1664695802}
  _rightButton: {fileID: 1664695801}
  _mover: {fileID: 907836357}
  _rotater: {fileID: 907836356}
  _holder: {fileID: 250307634}
  _specifications:
  - name: Rambo
    history: 'An experienced fighter who has visited many hot spots around the world.
      It would take a long time to list his awards, but one thing is for sure - Rambo
      is the best of the best, the real elite of the armed forces. Rambo is skilled
      with melee weapons such

      +20% to damage and speed of use and firing speed
      of SMGs and shotguns.

      -10% accuracy of all weapons.'
    health: 210
    armour: 180
    speed: 0.8
    ammo: 1.7
    skills:
    - name: Last Blood
      description: 'When activated, Rambo stops feeling pain and taking damage for
        some time.

        If the next damage taken is fatal and the ability is
        ready to be used, it will activate automatically.'
      type: 1
      value: 120
    - name: Supplies
      description: 'When activated, grants 10% health and 12% armor.

        Replenishes
        20% of all ammunition from the maximum value.'
      type: 0
      value: 2
  - name: Boot
    history: 'Booth is an experienced operative specializing in espionage operations.
      He is extremely secretive, it is difficult to say how many operations he has
      taken part in or even how old he is or whether his name is really Booth. We
      can only say with confidence that he has eliminated many terrorist groups and
      is eliminating more than one.

      Pistol damage +50%.

      Speed of using
      pistols and automatic rifles +10%.'
    health: 150
    armour: 110
    speed: 1
    ammo: 1.2
    skills:
    - name: Acute reaction
      description: 'Using the ability slows down time for a while.

        Opponents
        are slowed down more than Booth.'
      type: 1
      value: 60
    - name: Trick
      description: When used, enemies begin to attack a random ally, ignoring Booth.
      type: 0
      value: 2
  - name: Shadow
    history: 'The Shadow is an eternal silent person who prefers loneliness to any
      company. Behind his modest character lies a master of murder who leaves no
      chance for his victims. There is no person in the world who can hide from a
      Shadow''s bullet.

      +20% damage to sniper rifles.

      +25% speed of
      using sniper rifles.

      +25% accuracy and -20% firing speed for all weapons.

      +5%
      chance for critical attacks.'
    health: 100
    armour: 80
    speed: 1.5
    ammo: 1
    skills:
    - name: "\u041D\u0435\u0441\u043E\u043A\u0440\u0443\u0448\u0438\u043C\u044B\u0439"
      description: "\u041F\u0440\u0438 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438
        \u0420\u044D\u043C\u0431\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0435\u0442
        \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0431\u043E\u043B\u044C
        \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u0443\u0440\u043E\u043D
        \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438
        4 \u0441\u0435\u043A\u0443\u043D\u0434. \n\u0415\u0441\u043B\u0438 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
        \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0439 \u0443\u0440\u043E\u043D
        \u0431\u0443\u0434\u0435\u0442 \u0444\u0430\u0442\u0430\u043B\u044C\u043D\u044B\u043C
        \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
        \u0433\u043E\u0442\u043E\u0432\u0430 \u043A \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044E,
        \u0442\u043E \u043E\u043D\u0430 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442\u0441\u044F
        \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.\n"
      type: 0
      value: 0
    - name: "\u041F\u0440\u0438\u043F\u0430\u0441\u044B"
      description: "\u041F\u0440\u0438 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438
        \u043F\u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
        10% \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0438 12% \u0431\u0440\u043E\u043D\u0438.\n\u041F\u043E\u043F\u043E\u043B\u043D\u044F\u0435\u0442
        20% \u0432\u0441\u0435\u0439 \u0430\u043C\u0443\u043D\u0438\u0446\u0438\u0438
        \u043E\u0442 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F."
      type: 1
      value: 2
  _firstSkillCooldownTextBefore: 'Cooldown:'
  _firstSkillCooldownTextAfter: sec
  _secondSkillCooldownText: 'Maximum charges:'
