    <BackgroundColor>k__BackingField: {r: 0, g: 0, b: 0, a: 0}
    <Opened>k__BackingField: 0
  - <Name>k__BackingField: Hardness
    <Description>k__BackingField: When stationary, damage increases by 50%.
