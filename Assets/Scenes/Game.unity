    <BackgroundColor>k__BackingField: {r: 0, g: 0, b: 0, a: 0}
    <Opened>k__BackingField: 0
  - <Name>k__BackingField: Atlant
    <Description>k__BackingField: +5% damage for every 100 coins in stock.
    <Sprite>k__BackingField: {fileID: 21300000, guid: 654f1188d88eeeb4ba5934f5755e41a0,
      type: 3}
    <BackgroundColor>k__BackingField: {r: 0, g: 0, b: 0, a: 0}
    <Opened>k__BackingField: 0
  - <Name>k__BackingField: Reserve armor
    <Description>k__BackingField: When armor is broken, instantly restore 10% armor.
