    <BackgroundColor>k__BackingField: {r: 0, g: 0, b: 0, a: 0}
    <Opened>k__BackingField: 0
  - <Name>k__BackingField: Gambling
    <Description>k__BackingField: +50% critical attack damage, but normal attacks
