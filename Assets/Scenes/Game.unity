  <TalentsInfo>k__BackingField:
  - <Name>k__BackingField: Iron hand
    <Description>k__BackingField: Non-critical damage increases by 20%.
    <Sprite>k__BackingField: {fileID: 21300000, guid: 654f1188d88eeeb4ba5934f5755e41a0,
      type: 3}
    <BackgroundColor>k__BackingField: {r: 0, g: 0, b: 0, a: 0}
    <Opened>k__BackingField: 0
  - <Name>k__BackingField: Best number
    <Description>k__BackingField: Every 4th attack deals 80% more damage.
    <Sprite>k__BackingField: {fileID: 21300000, guid: 654f1188d88eeeb4ba5934f5755e41a0,
      type: 3}
    <BackgroundColor>k__BackingField: {r: 0, g: 0, b: 0, a: 0}
    <Opened>k__BackingField: 0
  - <Name>k__BackingField: Nimble Pocket
    <Description>k__BackingField: When picking up an object, movement speed increases
