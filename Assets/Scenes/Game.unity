      type: 3}
    <BackgroundColor>k__BackingField: {r: 0, g: 0, b: 0, a: 0}
    <Opened>k__BackingField: 0
  - <Name>k__BackingField: Abnormal speed
    <Description>k__BackingField: +2% movement speed for every 10% shield.
    <Sprite>k__BackingField: {fileID: 21300000, guid: 29d26b5186befda448b70fcbe49a1984,
      type: 3}
    <BackgroundColor>k__BackingField: {r: 0, g: 0, b: 0, a: 0}
    <Opened>k__BackingField: 0
  - <Name>k__BackingField: Bullet Bank
    <Description>k__BackingField: All ammo collected is converted into ammo used
